# ========================================================
# CrackPlace AI Frontend — Environment Variables Example
# ========================================================

# Backend API & WebSocket Endpoint
# For Local Development: http://localhost:5000
# For Production: https://your-backend-service.onrender.com (or your API domain)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Frontend Public Web Application URL (Optional, defaults to window.location.origin)
# Used for generating Custom Battle and room invitation URLs
VITE_APP_URL=http://localhost:5173

# Supabase Question Bank Configuration (Client-safe Publishable / Anon Key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

