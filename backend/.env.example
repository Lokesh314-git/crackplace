# ========================================================
# CrackPlace AI Backend — Environment Variables Example
# ========================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# CORS Allowed Origin(s)
# Supports comma-separated domains (e.g. https://crackplace.vercel.app,http://localhost:5173)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK Configuration
# Option 1 (Recommended for Cloud Hosting): Paste full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}
# Option 2 (Local Development): Keep serviceAccountKey.json in the backend/ root directory (strictly gitignored)

# Supabase Question Bank Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis Configuration (Optional for single node, Recommended for 500+ battles/horizontal scaling)
# Defaults to in-memory fallback if unset or offline
REDIS_URL=redis://localhost:6379

# OpenRouter AI Keys (for AI Mentor, Explanations, and Mock HR Interview)
OPENROUTER_QWEN_KEY=
OPENROUTER_KIMI_KEY=
OPENROUTER_FALLBACK_KEY=
