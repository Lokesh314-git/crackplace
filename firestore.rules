rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Utility functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow creation of a student profile if authenticated and set their own UID with non-escalated defaults
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
        (!('coins' in request.resource.data) || request.resource.data.coins <= 100) &&
        (!('xp' in request.resource.data) || request.resource.data.xp == 0) &&
        (!('level' in request.resource.data) || request.resource.data.level == 1);
      
      // Allow update by owner or admin
      // Critical security rule: Non-admins CANNOT change role, coins, xp, level, or battleRating!
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'coins', 'xp', 'totalXp', 'level', 'battleRating']))
      );
      allow delete: if isAdmin();
    }

    // Quizzes (Managed exclusively by server)
    match /quizzes/{quizId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Daily Challenges
    match /daily_challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Battles
    match /battles/{battleId} {
      allow read: if isAuthenticated();
      // Allow join or update battle if authenticated
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Leaderboards
    match /leaderboards/{boardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /ranks/{rankId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // Battle Rooms (Friend Lobbies)
    match /battleRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Study Notes (Self-test)
    match /studyNotes/{noteId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    // Coding Problems Catalog
    match /coding_problems/{problemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Mock HR Interviews
    match /mock_interviews/{interviewId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // PvP Battle History
    match /battleHistory/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
